<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_modern"
    android:padding="12dp">

    <!-- Transaction Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transaction_time"
            android:textColor="@color/text_secondary_modern"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textTransactionTimeCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_time"
            android:textColor="@color/text_primary_modern"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Coin KW Value -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/coin_kwvalue"
            android:textColor="@color/text_secondary_modern"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textCoinKwValueCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_balance"
            android:textColor="@color/success_modern"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Estimated Balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/estimated_balance"
            android:textColor="@color/text_secondary_modern"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textEstimatedBalanceCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_balance"
            android:textColor="@color/text_primary_modern"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Total Balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="총 잔고"
            android:textColor="@color/text_secondary_modern"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textTotalBalanceCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_balance"
            android:textColor="@color/success_modern"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Last Buy Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/last_buy_price"
            android:textColor="@color/text_secondary_modern"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textLastBuyPriceCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_buy_price"
            android:textColor="@color/buy_modern"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Last Sell Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/last_sell_price"
            android:textColor="@color/text_secondary_modern"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textLastSellPriceCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_sell_price"
            android:textColor="@color/sell_modern"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Next Buy Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/next_buy_price"
            android:textColor="@color/text_secondary_modern"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textNextBuyPriceCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_next_buy"
            android:textColor="@color/buy_modern"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

